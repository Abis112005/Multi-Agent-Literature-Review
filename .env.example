# ====================================================================
# Environment Configuration for Multi-Agent Literature Review System
# ====================================================================

# OpenAlex Polite Pool (recommended: provide your email for faster & higher rate limits)
OPENALEX_MAILTO=researcher@example.edu

# Semantic Scholar API Key (optional - rate limit is relaxed if provided)
SEMANTIC_SCHOLAR_API_KEY=

# LLM Provider Configuration
# Supported options: "ollama", "openai_compatible", "huggingface", "heuristic"
DEFAULT_LLM_PROVIDER=heuristic

# Ollama Settings (when using local Ollama instance)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# OpenAI-Compatible External Provider (Optional, e.g., Groq, DeepSeek, LocalAI, vLLM)
OPENAI_API_BASE=
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-3.5-turbo

# Hugging Face Settings (Optional)
HUGGINGFACE_MODEL_NAME=google/flan-t5-base

# Cache & Storage Settings
CACHE_DIR=./data/cache
REPORTS_DIR=./data/reports
PAPERS_DIR=./data/papers
REQUEST_TIMEOUT_SECONDS=15
